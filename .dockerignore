# The Dockerfile names what it copies, so this is a second line of defence and
# a smaller context to upload, not the only thing standing between a stray
# local file and a build layer.

# The build runs `npm ci` and `npm run build` itself; anything produced by a
# previous local build would only shadow what this one makes.
.git
.gitignore
node_modules
dist
storybook-static
*.tsbuildinfo

# Never into an image: the data directory is a volume, and the secrets are
# environment. `.npmrc` is here because an untracked one holding a registry
# token would otherwise be copied into a build layer by `COPY . .`, long
# after the install that might have wanted it.
data
.env
.env.*
.npmrc

# Local development state, never part of a build: agent worktrees and session
# state under `.claude/`, and the devlog `COPY . .` would otherwise sweep in.
.claude/
.byre-devlog/

# Coverage reports, produced by `test:coverage` and of no use in an image.
coverage/

.DS_Store
core
core.*
